# ──────────────────────────────────────────────────────────────────────────────
# PDLC Jira MCP Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to Git — only commit .env.example.
# ──────────────────────────────────────────────────────────────────────────────

# ── Jira Credentials ──────────────────────────────────────────────────────────
# Your Jira site URL
# Example: https://yoursite.atlassian.net
JIRA_URL=

# Jira account email address
JIRA_USERNAME=

# Jira API token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Comma-separated list of enabled Jira tools. Leave empty to enable all.
ENABLED_JIRA_TOOLS=

# ── Server Port ───────────────────────────────────────────────────────────────
JIRA_PORT=

# ── Azure App Configuration (optional — production/Azure only) ────────────────
# Leave empty for local development; JIRA_* values above are used instead.
AZURE_APPCONFIG_ENDPOINT=
APP_NAME=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=
